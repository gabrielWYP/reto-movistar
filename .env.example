SONIA_APP_NAME=SON-IA
SONIA_APP_VERSION=0.1.0
SONIA_ENVIRONMENT=development
SONIA_HOST=0.0.0.0
SONIA_PORT=8080
SONIA_LOG_LEVEL=INFO
SONIA_FRONTEND_DIR=front
SONIA_BI_MODEL=deepseek-v4-flash
OPENCODE_KEY=
SONIA_COLLECTIONS_DATASET=
SONIA_COLLECTIONS_MODEL=deepseek-v4-flash
SONIA_COLLECTIONS_MAX_TOOL_CALLS=
SONIA_COLLECTIONS_MAX_OUTPUT_TOKENS=
SONIA_COLLECTIONS_MAX_UPLOAD_BYTES=26214400
SONIA_COLLECTIONS_MAX_UPLOAD_FILES=6

# Object storage for the run audit trail (OCI S3-compatible endpoint).
# Leave empty to disable auditing; the run pipeline is unaffected either way.
SONIA_OCI_NAMESPACE=
SONIA_OCI_BUCKET=
SONIA_OCI_REGION=us-ashburn-1
SONIA_OCI_ACCESS_KEY_ID=
SONIA_OCI_SECRET_ACCESS_KEY=
