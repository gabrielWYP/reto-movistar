# Runtime HTTP del backend compartido.
SONIA_HOST=0.0.0.0
SONIA_PORT=8080
SONIA_LOG_LEVEL=INFO

# Dataset ZIP compatible. La ruta real y el dataset nunca se versionan.
SONIA_COLLECTIONS_DATASET=

# Configuración no secreta. Los valores vacíos usan los defaults centralizados del código.
# Déjalos vacíos para usar los defaults centralizados en config.py.
SONIA_COLLECTIONS_MODEL=
SONIA_COLLECTIONS_REASONING_EFFORT=
SONIA_COLLECTIONS_MAX_TOOL_CALLS=
SONIA_COLLECTIONS_MAX_OUTPUT_TOKENS=
SONIA_COLLECTIONS_MAX_UPLOAD_BYTES=26214400
SONIA_COLLECTIONS_MAX_UPLOAD_FILES=6

# Secret: se inyecta únicamente en runtime.
OPENAI_API_KEY=
