# Directorio con los cinco CSV Billing o ZIP oficial. Nunca se versiona.
SONIA_DATASET=/data
SONIA_HOST=0.0.0.0
SONIA_PORT=8080
SONIA_LOG_LEVEL=INFO
SONIA_MAX_UPLOAD_MB=20
SONIA_MAX_UNCOMPRESSED_MB=48
SONIA_MAX_UPLOAD_FILES=5
SONIA_DATASET_TTL_SECONDS=14400

# IA opcional. Sin key, el fallback determinístico permanece operativo.
OPENAI_API_KEY=
SONIA_BILLING_MODEL=gpt-5
